# =============================================================================
# MIT.egy — Environment Variables Template
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# NEVER commit the real .env file. It's already in .gitignore.
# =============================================================================

# --- Resend (Email) ---
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The "from" email address. Must be on a verified domain in Resend.
# While testing, you can use Resend's default onboarding address.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Where internal contact-form notifications will be delivered.
CONTACT_TO_EMAIL=menanet305@gmail.com

# --- App ---
# Public site URL (used for canonical URLs and metadataBase)
NEXT_PUBLIC_SITE_URL=https://mit-egy.vercel.app

# --- Allowed origins for CSRF check (comma-separated) ---
# These are the only origins allowed to POST to /api/contact
ALLOWED_ORIGINS=https://mit-egy.vercel.app,http://localhost:3000

# --- Node env ---
NODE_ENV=development
